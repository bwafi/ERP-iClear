# Contoh konfigurasi environment untuk development lokal.
#
#   cp .env.example .env
#
# File `.env` TIDAK ikut Git (lihat .gitignore). Jangan pernah menaruh
# kredensial production di sini — gunakan kredensial lokal di bawah.

#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------

CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

app.baseURL = 'http://localhost:8080/'
app.indexPage = ''

#--------------------------------------------------------------------
# DATABASE (hostname mengikuti service di compose.yaml)
#--------------------------------------------------------------------

database.default.hostname = erp-db
database.default.database = erp_local
database.default.username = erp
database.default.password = erp
database.default.DBDriver = MySQLi
database.default.port = 3306
database.default.DBPrefix =

#--------------------------------------------------------------------
# TEST (default aman: SQLite in-memory)
# Jangan arahkan ke database yang sama dengan database kerja.
#--------------------------------------------------------------------

# database.tests.database = erp_test

#--------------------------------------------------------------------
# GITHUB (KPI IT — sync commit feat/fix/docs)
# Token: fine-grained PAT, read-only Contents + Metadata untuk SEMUA repo.
# Format: owner/repo[:branch], pisahkan koma.
#--------------------------------------------------------------------

GITHUB_TOKEN =
GITHUB_REPOS = 'bwafi/ERP-iClear:main, bwafi/CrmIclear:main, bwafi/NAMA_REPO_KETIGA:main'
# Opsional: filter author commit (email atau login GitHub), pisahkan koma.
# Kosong = semua commit di repo dihitung.
GITHUB_AUTHORS =

#--------------------------------------------------------------------
# KPI IT — CEK UPTIME TERJADWAL
# Cek dijalankan cron 3x sehari (`php spark it:uptime-check`); tiap cek
# menambah satu baris ke backups/uptime.jsonl.
# Marker opsional: teks yang wajib ada di halaman (kosong = cukup HTTP 200).
#--------------------------------------------------------------------

KPI_UPTIME_URL = https://erp.icleargroup.id/login
KPI_UPTIME_MARKER =
KPI_UPTIME_TIMEOUT = 10
KPI_TIMEZONE = Asia/Jakarta

#--------------------------------------------------------------------
# BACKUP DATABASE (cron `php spark backup:db`)
#--------------------------------------------------------------------

BACKUP_KEEP_DAYS = 30
# BACKUP_DIR = /home/USER/backups
BACKUP_TIMEZONE = Asia/Jakarta
