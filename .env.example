# Contoh konfigurasi environment untuk development lokal.
#
#   cp .env.example .env
#
# File `.env` TIDAK ikut Git (lihat .gitignore). Jangan pernah menaruh
# kredensial production di sini — gunakan kredensial lokal di bawah.

#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------

CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

app.baseURL = 'http://localhost:8080/'
app.indexPage = ''

#--------------------------------------------------------------------
# DATABASE (hostname mengikuti service di compose.yaml)
#--------------------------------------------------------------------

database.default.hostname = erp-db
database.default.database = erp_local
database.default.username = erp
database.default.password = erp
database.default.DBDriver = MySQLi
database.default.port = 3306
database.default.DBPrefix =

#--------------------------------------------------------------------
# TEST (default aman: SQLite in-memory)
# Jangan arahkan ke database yang sama dengan database kerja.
#--------------------------------------------------------------------

# database.tests.database = erp_test
